# Postgres container credentials (read by docker-compose.yml)
POSTGRES_USER=kitchen
POSTGRES_PASSWORD=kitchen
POSTGRES_DB=kitchen_erp

# Required by lib/config.ts — the app throws at startup if any are missing
DATABASE_URL="postgresql://kitchen:kitchen@localhost:5432/kitchen_erp?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="generate-with-openssl-rand-hex-32"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
