generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  PROCUREMENT_MANAGER
  PRODUCTION_MANAGER
  BRANCH_MANAGER
  ACCOUNTING
  VIEWER
}

/// COMMISSARY supplies other branches; OUTLET receives from one. Both cook.
enum BranchType {
  COMMISSARY
  OUTLET
}

enum PRStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CONVERTED_TO_PO
}

enum POStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CANCELLED
}

/// Variance is not a status: it is derived from the lines, and a report can
/// carry one while it is still pending.
enum RRStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

/// Draft → submit → accounting decides, then the kitchen runs it, reports it
/// done with the actual yield (PENDING_COMPLETION), and accounting signs the
/// completion off (COMPLETED — stock moves then, Week 6).
/// REJECTED and CANCELLED are terminal.
enum ProductionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  IN_PROGRESS
  PENDING_COMPLETION
  COMPLETED
  CANCELLED
}

/// What a BOM makes its finished good from (Week 7 Task 1, D2):
///   PRODUCTION  materials only, cooked through a production order
///   CONVERSION  another finished good (the source, e.g. unsold Lechon) plus
///               added materials, through a conversion order
enum BomKind {
  PRODUCTION
  CONVERSION
}

/// A conversion order records a conversion already done (no draft), so it is
/// created PENDING_APPROVAL; accounting's approval is what moves the stock.
/// REJECTED is terminal (Week 7 Task 1, D4 / D6).
enum ConversionStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

/// Why a lot was written off (Week 7 Task 2, W3): categories, not free text,
/// so waste can be counted by cause (Week 10's Waste Pattern Detector, Week
/// 11's Waste report). OTHER needs a note.
enum WriteOffReason {
  EXPIRED
  /// Gone bad before its expiry.
  SPOILED
  /// Dropped, contaminated.
  DAMAGED
  /// Failed a taste or quality check.
  FAILED_QUALITY
  OTHER
}

/// Recording a write-off submits it (no draft), so it is created
/// PENDING_APPROVAL; accounting's approval is what moves the stock.
/// REJECTED is terminal (Week 7 Task 2, W4).
/// PENDING_APPROVAL → APPROVED (dispatched, in transit) → RECEIVED, or
/// REJECTED (final). Week 8 Task 2 uses PENDING_APPROVAL; Task 3 the rest.
enum TransferStatus {
  PENDING_APPROVAL
  APPROVED
  RECEIVED
  REJECTED
}

enum WriteOffStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
  WASTE
}

// ─── USERS ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  managedBranch           Branch?           @relation("BranchManager")
  approvals               Approval[]
  submittedPurchaseOrders PurchaseOrder[]   @relation("PurchaseOrderSubmitter")
  purchaseRequests        PurchaseRequest[]
  productionOrders        ProductionOrder[]   @relation("ProductionOrderRequester")
  submittedProductionOrders ProductionOrder[] @relation("ProductionOrderSubmitter")
  completedProductionOrders ProductionOrder[] @relation("ProductionOrderCompleter")
  submittedConversionOrders ConversionOrder[] @relation("ConversionOrderSubmitter")
  submittedWriteOffs        WriteOff[]        @relation("WriteOffSubmitter")
  submittedStockTransfers   StockTransfer[]   @relation("StockTransferSubmitter")
  productionStatusChanges ProductionStatusChange[]
  notifications           Notification[]
  receivingReports        ReceivingReport[] @relation("ReceivingReportReceiver")
}

// ─── BRANCHES ────────────────────────────────────────────────────────────────

/// A kitchen location. Every branch cooks; the type says which one supplies
/// the others — transfers (Week 8) go from a commissary to its outlets.
model Branch {
  id        String     @id @default(cuid())
  name      String     @unique
  /// Short label (MAIN, CUB) for tables and transfer documents. Fixed once
  /// created, like a material code, so printed references stay valid.
  code      String     @unique
  type      BranchType
  address   String?
  phone     String?
  /// One manager per branch, and a manager runs one branch: @unique makes the
  /// database hold both (Week 8 Task 1, B4). Read from here — not from the
  /// login token, whose branchId can be hours stale — when deciding who may
  /// act for a branch.
  managerId String?    @unique
  manager   User?      @relation("BranchManager", fields: [managerId], references: [id], onDelete: SetNull)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  users             User[]
  inventoryLevels   InventoryLevel[]
  stockTransfersOut StockTransfer[]   @relation("TransferFrom")
  stockTransfersIn  StockTransfer[]   @relation("TransferTo")
  productionOrders  ProductionOrder[]
  receivingReports  ReceivingReport[]
  stockMovements    StockMovement[]
  finishedGoodLevels    FinishedGoodLevel[]
  finishedGoodMovements FinishedGoodMovement[]
  conversionOrders      ConversionOrder[]
  writeOffs             WriteOff[]
}

// ─── CATEGORIES & UNITS ───────────────────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  type      String   // 'RAW_MATERIAL' | 'FINISHED_GOOD' | 'PACKAGING'
  createdAt DateTime @default(now())

  materials    Material[]
  finishedGoods FinishedGood[]
}

model Unit {
  id           String @id @default(cuid())
  name         String @unique
  abbreviation String @unique

  materials Material[]
  finishedGoods FinishedGood[]
  bomItems  BOMItem[]
  boms      BOM[]
}

// ─── MATERIALS ────────────────────────────────────────────────────────────────

model Material {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  description  String?
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id])
  unitId       String
  unit         Unit     @relation(fields: [unitId], references: [id])
  reorderPoint Decimal  @default(0)
  /// Deprecated — superseded by ItemPrice, which carries effective-dated history.
  /// Kept only so the change is additive; nothing reads it. Drop in a later change.
  standardCost Decimal  @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  inventoryLevels      InventoryLevel[]
  stockMovements       StockMovement[]
  purchaseRequestItems PurchaseRequestItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  receivingItems       ReceivingReportItem[]
  bomItems             BOMItem[]
  itemPrices           ItemPrice[]

  @@index([categoryId])
}

// ─── ITEM PRICES ──────────────────────────────────────────────────────────────

/// Effective-dated purchase price history for a Material.
///
/// Rows are open-ended: there is no endDate. The price in force on a given date
/// is the newest row whose effectiveDate is on or before it. "Current" is always
/// derived, never stored, so it cannot drift out of sync the way a validFrom/
/// validTo pair can when only one of the two writes lands.
///
/// supplierId is nullable and the null case is meaningful:
///   - null     → the organisation-wide reference price for the material
///   - non-null → that supplier's quoted price
/// Lookups for a specific supplier prefer that supplier's row and fall back to
/// the reference row. See ItemPriceRepository.findPriceAsOf.
model ItemPrice {
  id            String    @id @default(cuid())
  materialId    String
  material      Material  @relation(fields: [materialId], references: [id])
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  unitPrice     Decimal
  effectiveDate DateTime
  note          String?
  createdAt     DateTime  @default(now())

  // Reference-price lookups: newest row <= asOf for a material.
  @@index([materialId, effectiveDate])
  // Supplier-scoped lookups hit the same table with an extra equality column.
  @@index([materialId, supplierId, effectiveDate])
}

// ─── FINISHED GOODS ───────────────────────────────────────────────────────────

model FinishedGood {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  description  String?
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id])
  unitId       String
  unit         Unit     @relation(fields: [unitId], references: [id])
  sellingPrice Decimal  @default(0)
  /// How long it keeps once cooked, in whole hours (1–720). A lot's expiry is
  /// the moment its run was reported done plus this (Week 6 Task 4). Null
  /// until an admin sets it; a completion cannot be approved without it.
  shelfLifeHours Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  boms              BOM[]             @relation("BomOutput")
  /// Conversion BOMs that use this good as their source.
  conversionBoms    BOM[]             @relation("BomConversionSource")
  productionOrders  ProductionOrder[]
  conversionOrders  ConversionOrder[] @relation("ConversionOrderOutput")
  conversionSources ConversionOrder[] @relation("ConversionOrderSource")
  lots              FinishedGoodLot[]
  transferItems     StockTransferItem[]
}

// ─── BOM ─────────────────────────────────────────────────────────────────────

/// A recipe version for a FinishedGood.
///
/// BOMItem quantities are stated per ONE BATCH of batchSize batchUnit — i.e. as
/// the recipe card is actually written ("this makes 10 kg"), not normalised to a
/// single unit. Normalising would round small ingredients (0.0035 kg of salt per
/// kg) and make the stored rows impossible to check against the physical recipe.
/// Scaling to a target quantity is derived: factor = targetQty / batchSize.
///
/// Versions are immutable. An edit supersedes the active version with a new one
/// (isActive = false on the old); rows are never mutated or deleted, because
/// ProductionOrder pins bomId and a completed run must keep reporting the
/// ingredients it actually consumed.
///
/// A finished good can have one active version per KIND (Week 7 Task 1, D2):
/// Lechon Paksiw is cooked from bought roasted pork (PRODUCTION) and also made
/// from unsold Lechon (CONVERSION). Versions are numbered per kind, so the two
/// recipes read "v1" and "Conversion v1" rather than one borrowing the other's
/// numbers. Production planning only ever sees PRODUCTION versions.
model BOM {
  id             String       @id @default(cuid())
  finishedGoodId String
  finishedGood   FinishedGood @relation("BomOutput", fields: [finishedGoodId], references: [id])
  kind           BomKind      @default(PRODUCTION)
  version        Int          @default(1)
  isActive       Boolean      @default(true)
  batchSize      Decimal
  batchUnitId    String
  batchUnit      Unit         @relation(fields: [batchUnitId], references: [id])
  /// CONVERSION only: the finished good converted (e.g. Lechon) and how much
  /// of it one batch of batchSize uses, in the source good's own unit — the
  /// source's line of the recipe, kept apart from BOMItem because it comes
  /// out of finished-goods lots, not material stock. Both null on a
  /// PRODUCTION version; a CHECK constraint holds the pairing (migration
  /// 20261112090000_conversion_orders).
  sourceFinishedGoodId String?
  sourceFinishedGood   FinishedGood? @relation("BomConversionSource", fields: [sourceFinishedGoodId], references: [id])
  sourceQuantity       Decimal?
  notes          String?
  createdAt      DateTime     @default(now())

  items            BOMItem[]
  productionOrders ProductionOrder[]
  conversionOrders ConversionOrder[]

  @@unique([finishedGoodId, kind, version])
  @@index([finishedGoodId, kind, isActive])
}

model BOMItem {
  id         String   @id @default(cuid())
  bomId      String
  bom        BOM      @relation(fields: [bomId], references: [id])
  materialId String
  material   Material @relation(fields: [materialId], references: [id])
  quantity   Decimal
  unitId     String
  unit       Unit     @relation(fields: [unitId], references: [id])
  notes      String?

  @@index([bomId])
}

// ─── SUPPLIERS ───────────────────────────────────────────────────────────────

model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  taxId       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  itemPrices     ItemPrice[]
}

// ─── PURCHASE REQUESTS ────────────────────────────────────────────────────────

model PurchaseRequest {
  id            String    @id @default(cuid())
  prNumber      String    @unique
  requestedById String
  requester     User      @relation(fields: [requestedById], references: [id])
  status        PRStatus  @default(DRAFT)
  notes         String?
  neededBy      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items          PurchaseRequestItem[]
  purchaseOrders PurchaseOrder[]

  @@index([status])
  @@index([requestedById])
}

model PurchaseRequestItem {
  id                String          @id @default(cuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id])
  materialId        String
  material          Material        @relation(fields: [materialId], references: [id])
  quantity          Decimal
  estimatedUnitCost Decimal?
  notes             String?

  @@index([purchaseRequestId])
}

// ─── PURCHASE ORDERS ──────────────────────────────────────────────────────────

model PurchaseOrder {
  id                String           @id @default(cuid())
  poNumber          String           @unique
  purchaseRequestId String?
  purchaseRequest   PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id])
  supplierId        String?
  supplier          Supplier?        @relation(fields: [supplierId], references: [id])
  submittedById     String?
  submittedBy       User?            @relation("PurchaseOrderSubmitter", fields: [submittedById], references: [id])
  status            POStatus         @default(DRAFT)
  totalAmount       Decimal          @default(0)
  expectedDelivery  DateTime?
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  items            PurchaseOrderItem[]
  receivingReports ReceivingReport[]

  @@index([status])
  @@index([supplierId])
  @@index([purchaseRequestId])

}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  materialId      String
  material        Material      @relation(fields: [materialId], references: [id])
  quantity        Decimal
  unitCost        Decimal
  totalCost       Decimal

  receivingItems ReceivingReportItem[]

  @@index([purchaseOrderId])
}

// ─── RECEIVING REPORTS ────────────────────────────────────────────────────────

model ReceivingReport {
  id              String        @id @default(cuid())
  rrNumber        String        @unique
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  /// Where the delivery physically arrived — the branch whose stock it raises.
  branchId        String
  branch          Branch        @relation(fields: [branchId], references: [id])
  /// Who counted it. Never the approver: nobody approves their own work.
  receivedById    String
  receivedBy      User          @relation("ReceivingReportReceiver", fields: [receivedById], references: [id])
  status          RRStatus      @default(DRAFT)
  receivedAt      DateTime      @default(now())
  notes           String?
  createdAt       DateTime      @default(now())

  items ReceivingReportItem[]

  @@index([purchaseOrderId])
  @@index([status])
  @@index([branchId])
}

model ReceivingReportItem {
  id                  String            @id @default(cuid())
  receivingReportId   String
  receivingReport     ReceivingReport   @relation(fields: [receivingReportId], references: [id])
  /// The order line this counts against. Outstanding is tracked per PO line,
  /// and a PO may list the same material twice, so materialId cannot stand in.
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  materialId          String
  material            Material          @relation(fields: [materialId], references: [id])
  orderedQuantity     Decimal
  /// What was still outstanding on the order line when this was counted —
  /// variance is measured against it. Stored because once the report is
  /// approved its own acceptance changes outstanding, so it cannot be derived
  /// back. Rewritten on every draft save.
  expectedQuantity    Decimal
  receivedQuantity    Decimal
  rejectedQuantity    Decimal           @default(0)
  unitCost            Decimal
  notes               String?

  @@index([receivingReportId])
  @@index([purchaseOrderItemId])
}

// ─── INVENTORY ───────────────────────────────────────────────────────────────

model InventoryLevel {
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id])
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])
  quantity   Decimal  @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([materialId, branchId])
}

/// The stock ledger: append-only, one row per change to one material at one
/// branch. Two rules every writer keeps:
///
/// - quantity is SIGNED — positive into stock, negative out of it — so the
///   balance is SUM(quantity) and must equal InventoryLevel.quantity for the
///   same material and branch. MovementType alone cannot give direction: a
///   TRANSFER is out at one branch and in at another.
/// - every row names the document that caused it (referenceType +
///   referenceId, e.g. 'ReceivingReport' + its id). Polymorphic, so not a
///   foreign key, but NOT NULL.
///
/// Write through InventoryRepository, which changes the ledger and the level
/// together on the caller's transaction.
model StockMovement {
  id            String       @id @default(cuid())
  materialId    String
  material      Material     @relation(fields: [materialId], references: [id])
  /// InventoryLevel is per material + branch, so the ledger must be too or the
  /// two cannot be reconciled.
  branchId      String
  branch        Branch       @relation(fields: [branchId], references: [id])
  type          MovementType
  quantity      Decimal
  /// Purchase cost per unit for stock that came in from a receiving report,
  /// copied from its line. Null where no cost rule exists yet (outgoing,
  /// adjustments, transfers): the costing method is Week 6's decision.
  unitCost      Decimal?
  referenceId   String
  referenceType String
  notes         String?
  createdAt     DateTime     @default(now())

  @@index([materialId, branchId, createdAt])
  @@index([referenceType, referenceId])
}

/// A Transfer Order (Week 8 Task 2): finished goods the kitchen sends from a
/// commissary to another branch, TRF-000001. Reshaped from the Week 1
/// material transfer, which was never used (T3). Recording it submits it to
/// accounting; stock moves only from Task 3 — out of the sender as TRANSFER
/// rows when approved (dispatched), into the receiver when received — so the
/// End of Day "Distributed" column balances at both ends.
model StockTransfer {
  id             String         @id @default(cuid())
  /// TRF-000001, from trf_number_seq.
  transferNumber String         @unique
  /// An active commissary when recorded (T5).
  fromBranchId   String
  fromBranch     Branch         @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranchId     String
  toBranch       Branch         @relation("TransferTo", fields: [toBranchId], references: [id])
  status         TransferStatus @default(PENDING_APPROVAL)
  /// Who recorded it. Never its approver, ADMIN included.
  submittedById  String
  submittedBy    User           @relation("StockTransferSubmitter", fields: [submittedById], references: [id])
  notes          String?
  /// When it was recorded and submitted.
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  items StockTransferItem[]

  @@index([status])
  @@index([fromBranchId])
  @@index([toBranchId])
}

/// One finished good on a transfer. Lots are not chosen here: dispatch takes
/// them soonest-expiry-first (T7) and records them on the movements.
model StockTransferItem {
  id              String        @id @default(cuid())
  stockTransferId String
  stockTransfer   StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  finishedGoodId  String
  finishedGood    FinishedGood  @relation(fields: [finishedGoodId], references: [id])
  /// In the finished good's unit; > 0.
  quantity        Decimal

  /// One line per finished good (T6).
  @@unique([stockTransferId, finishedGoodId])
}

// ─── FINISHED GOODS STOCK ────────────────────────────────────────────────────

/// One run's output of a finished good: the unit finished goods are stocked,
/// moved and (Week 7) expired by. Cooked food is perishable, so stock is kept
/// per lot rather than per finished good — expiry flags, transfers and
/// write-offs all need to know how much of which lot is where.
///
/// Separate from InventoryLevel / StockMovement, which are per material:
/// folding finished goods into them would need nullable foreign keys and
/// partial unique indexes that Prisma's upsert cannot use (Week 6 Task 2, D5).
model FinishedGoodLot {
  id                String           @id @default(cuid())
  /// A production lot takes its order's number (PRD-000005): one run is one
  /// lot, and the label leads straight back to the order (Week 6 Task 2, D6).
  lotNumber         String           @unique
  finishedGoodId    String
  finishedGood      FinishedGood     @relation(fields: [finishedGoodId], references: [id])
  /// The run that made it — at most one lot per run. Null for a lot that did
  /// not come from a production run.
  productionOrderId String?          @unique
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id])
  /// The conversion that made it, numbered after it (CNV-000001) — at most one
  /// lot per conversion (Week 7 Task 1, D8). Exactly one of productionOrderId
  /// and conversionOrderId is set.
  conversionOrderId String?          @unique
  conversionOrder   ConversionOrder? @relation(fields: [conversionOrderId], references: [id])
  /// Date-only (UTC midnight): the Manila date the kitchen reported the run
  /// done, or the conversion was recorded.
  producedOn        DateTime
  /// When it must no longer be used: the moment the run was reported done (or
  /// the conversion recorded) plus the finished good's shelf life, fixed when
  /// the lot is created so a later shelf-life change never moves a labelled
  /// lot (Week 6 Task 4). Null only for lots made before expiry was tracked.
  expiresAt         DateTime?
  createdAt         DateTime         @default(now())

  levels    FinishedGoodLevel[]
  movements FinishedGoodMovement[]
  writeOffs WriteOff[]

  @@index([finishedGoodId])
  // First-to-expire ordering, and Week 7's "expiring within 24/48 h".
  @@index([expiresAt])
}

/// Current quantity of one lot at one branch — InventoryLevel's counterpart.
/// Changed only together with a FinishedGoodMovement, through
/// FinishedGoodStockRepository, so updatedAt is the lot's last movement there.
model FinishedGoodLevel {
  id        String          @id @default(cuid())
  lotId     String
  lot       FinishedGoodLot @relation(fields: [lotId], references: [id])
  branchId  String
  branch    Branch          @relation(fields: [branchId], references: [id])
  quantity  Decimal         @default(0)
  updatedAt DateTime        @updatedAt

  @@unique([lotId, branchId])
  @@index([branchId])
}

/// The finished-goods ledger, under the same two rules as StockMovement:
/// quantity is SIGNED (in +, out −), so SUM(quantity) per lot and branch must
/// equal FinishedGoodLevel.quantity; and every row names the document that
/// caused it (referenceType + referenceId, NOT NULL, polymorphic). Append-only.
model FinishedGoodMovement {
  id            String          @id @default(cuid())
  lotId         String
  lot           FinishedGoodLot @relation(fields: [lotId], references: [id])
  branchId      String
  branch        Branch          @relation(fields: [branchId], references: [id])
  type          MovementType
  quantity      Decimal
  /// Cost per unit; null until the costing method sets it (Week 6).
  unitCost      Decimal?
  referenceId   String
  referenceType String
  notes         String?
  createdAt     DateTime        @default(now())

  @@index([lotId, branchId, createdAt])
  @@index([referenceType, referenceId])
}

// ─── PRODUCTION ───────────────────────────────────────────────────────────────

model ProductionOrder {
  id             String           @id @default(cuid())
  orderNumber    String           @unique
  finishedGoodId String
  finishedGood   FinishedGood     @relation(fields: [finishedGoodId], references: [id])
  bomId          String
  bom            BOM              @relation(fields: [bomId], references: [id])
  branchId       String
  branch         Branch           @relation(fields: [branchId], references: [id])
  requestedById  String
  requestedBy    User             @relation("ProductionOrderRequester", fields: [requestedById], references: [id])
  /// Who sent it for approval; null until submitted. Never its approver (Week 5 Task 5).
  submittedById  String?
  submittedBy    User?            @relation("ProductionOrderSubmitter", fields: [submittedById], references: [id])
  status         ProductionStatus @default(DRAFT)
  /// Output of one batch, in the BOM's batch unit (= the finished good's unit;
  /// the service refuses a mismatch). Defaults to BOM.batchSize on the form.
  batchWeight    Decimal
  batchCount     Int
  /// batchWeight × batchCount, stored because Week 6 compares actualQty with it.
  plannedQty     Decimal
  /// The actual yield the kitchen reported on completion, in the same unit.
  actualQty      Decimal?
  plannedDate    DateTime
  /// When the kitchen reported the run done (→ PENDING_COMPLETION), not when
  /// accounting signed it off — that is on the status log.
  completedAt    DateTime?
  /// Who reported it done; null until then. Never whoever approves the
  /// completion (Week 6), like submittedById for the plan.
  completedById  String?
  completedBy    User?            @relation("ProductionOrderCompleter", fields: [completedById], references: [id])
  /// Costing (Week 6 Task 3), all recorded when accounting approves the
  /// completion and never recomputed: prices can be back-dated, and a
  /// signed-off cost must not move. Null until then. Pesos, unrounded.
  /// The BOM at the planned quantities, at reference prices on plannedDate.
  plannedCost    Decimal?
  /// The same quantities at reference prices on the lot's production date —
  /// the batch cost.
  actualCost     Decimal?
  /// actualCost ÷ actualQty: what one unit (kg) of the output cost.
  costPerUnit    Decimal?
  /// actualCost − (plannedCost ÷ plannedQty) × actualQty: what the output
  /// cost beyond what that much should have cost at plan. Positive = over.
  costVariance   Decimal?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  statusChanges ProductionStatusChange[]
  /// What the run produced, once accounting signed the completion off.
  lot           FinishedGoodLot?

  @@index([status])
  @@index([branchId])
  @@index([plannedDate])
}

/// One row per status change of a production order — submit, approve / reject,
/// start, cancel, and (Week 6) complete — written in the same transaction as
/// the change itself, so the log cannot disagree with the status. It is the
/// order page's timeline and the audit trail of who moved it when. Creation is
/// not logged: the order's own createdAt and requestedById say that.
/// Append-only, like StockMovement.
model ProductionStatusChange {
  id                String           @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder  @relation(fields: [productionOrderId], references: [id])
  fromStatus        ProductionStatus
  toStatus          ProductionStatus
  changedById       String
  changedBy         User             @relation(fields: [changedById], references: [id])
  /// Approval remarks or the cancel reason; null when the change needs none.
  note              String?
  createdAt         DateTime         @default(now())

  @@index([productionOrderId, createdAt])
}

// ─── CONVERSIONS ─────────────────────────────────────────────────────────────

/// A conversion already done in the kitchen — unsold Lechon made into Lechon
/// Paksiw — recorded for accounting's approval (Week 7 Task 1). There is no
/// draft: the kitchen records what it used and made, and it is submitted as
/// it is created (D4). Nothing moves in stock until approval (D6), which in
/// one transaction takes the source out of its lots (soonest expiry first),
/// the added ingredients out of material stock, and puts the output in as a
/// new lot numbered after this order (D8).
///
/// The added ingredients are not stored: they are the pinned conversion BOM
/// scaled by sourceQty ÷ the BOM's sourceQuantity, like a production order's
/// requirements. Costs are recorded at approval and never recomputed (D7).
model ConversionOrder {
  id                   String           @id @default(cuid())
  /// CNV-000001, from cnv_number_seq.
  orderNumber          String           @unique
  /// The CONVERSION BOM version used, pinned when recorded.
  bomId                String
  bom                  BOM              @relation(fields: [bomId], references: [id])
  /// What it made (= the BOM's finished good) and what it was made from (= the
  /// BOM's source), kept on the order like ProductionOrder.finishedGoodId.
  finishedGoodId       String
  finishedGood         FinishedGood     @relation("ConversionOrderOutput", fields: [finishedGoodId], references: [id])
  sourceFinishedGoodId String
  sourceFinishedGood   FinishedGood     @relation("ConversionOrderSource", fields: [sourceFinishedGoodId], references: [id])
  /// Where it was done: the branch whose lots and stock it moves.
  branchId             String
  branch               Branch           @relation(fields: [branchId], references: [id])
  /// Who recorded it. Never its approver, ADMIN included (D6).
  submittedById        String
  submittedBy          User             @relation("ConversionOrderSubmitter", fields: [submittedById], references: [id])
  status               ConversionStatus @default(PENDING_APPROVAL)
  /// Source used, in the source good's unit (kg of Lechon).
  sourceQty            Decimal
  /// Output made, in the output good's unit (kg of Paksiw).
  outputQty            Decimal
  /// Costing (D7), recorded at approval and never recomputed; null until then.
  /// Pesos, unrounded. What the source lots taken were recorded at: Σ kg ×
  /// each lot's cost per unit.
  sourceCost           Decimal?
  /// The added ingredients at reference prices on the conversion date.
  conversionCost       Decimal?
  /// (sourceCost + conversionCost) ÷ outputQty — the output lot's cost per unit.
  costPerUnit          Decimal?
  notes                String?
  /// The moment it was recorded and submitted: its conversion date (Manila)
  /// and the start of the output's shelf life (D8).
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  /// What it produced, once approved.
  lot                  FinishedGoodLot?

  @@index([status])
  @@index([branchId])
}

// ─── WRITE-OFFS ──────────────────────────────────────────────────────────────

/// Finished goods that cannot be used or converted — expired, spoiled,
/// damaged — taken out of stock at what they cost (Week 7 Task 2). One lot at
/// one branch per write-off (W2): lots are how stock, expiry and cost are kept.
/// Recording it submits it; nothing moves until accounting approves it, which
/// in one transaction takes `quantity` out of the lot (a WASTE movement) and
/// records the cost (W4, W6). Raw-material write-offs are not covered (W1).
model WriteOff {
  id             String          @id @default(cuid())
  /// WO-000001, from wo_number_seq.
  writeOffNumber String          @unique
  lotId          String
  lot            FinishedGoodLot @relation(fields: [lotId], references: [id])
  /// Where the lot is: the branch whose stock it reduces.
  branchId       String
  branch         Branch          @relation(fields: [branchId], references: [id])
  /// Who recorded it. Never its approver, ADMIN included (W4).
  submittedById  String
  submittedBy    User            @relation("WriteOffSubmitter", fields: [submittedById], references: [id])
  status         WriteOffStatus  @default(PENDING_APPROVAL)
  /// In the lot's unit; part of a lot is allowed.
  quantity       Decimal
  reason         WriteOffReason
  /// Required when the reason is OTHER.
  notes          String?
  /// Costing (W6), recorded at approval and never recomputed; null until then.
  /// The lot's recorded cost per unit (its IN movement's unitCost).
  unitCost       Decimal?
  /// quantity × unitCost: the peso value lost. Pesos, unrounded.
  totalCost      Decimal?
  /// When it was recorded and submitted.
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status])
  // Other pending write-offs of the same lot, checked on submit (W5).
  @@index([lotId, status])
  @@index([branchId])
}

// ─── APPROVALS ───────────────────────────────────────────────────────────────

/// A recorded approve/reject decision on a workflow document.
///
/// Polymorphic by (referenceType, referenceId) — the same shape StockMovement
/// uses for its source-document link. One table covers PurchaseRequest and
/// PurchaseOrder now, and ProductionOrder / Conversion later, instead of a
/// near-identical approval table per workflow.
///
/// referenceId is deliberately NOT a foreign key: Postgres cannot express an FK
/// whose target table varies by row, so there is no DB-level guarantee it points
/// at a live row. The service layer passes a real id — treat this the way
/// StockMovement.referenceId is already treated (see docs/database.md).
model Approval {
  id            String   @id @default(cuid())
  referenceType String // 'PurchaseRequest' | 'PurchaseOrder' | 'ReceivingReport' | 'ProductionOrder' | 'ProductionCompletion' | 'ConversionOrder' | 'WriteOff'
  referenceId   String
  approverId    String
  approver      User     @relation(fields: [approverId], references: [id])
  decision      String // 'APPROVED' | 'REJECTED'
  remarks       String?
  decidedAt     DateTime @default(now())

  @@index([referenceType, referenceId])
}

// ─── NOTIFICATIONS ───────────────────────────────────────────────────────────

/// An in-app notification for one user. Written by the BullMQ worker on PR
/// submission (and later by other jobs). Week 3 only produces rows — the bell
/// UI that reads them is Week 11. readAt = null means unread.
model Notification {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  type          String
  title         String
  body          String?
  referenceType String?
  referenceId   String?
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, readAt])
}
