# Postgres container credentials (read by docker-compose.yml)
POSTGRES_USER=kitchen
POSTGRES_PASSWORD=kitchen
POSTGRES_DB=kitchen_erp

# Required by lib/config.ts — the app throws at startup if any are missing
DATABASE_URL="postgresql://kitchen:kitchen@localhost:5432/kitchen_erp?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="generate-with-openssl-rand-hex-32"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional — KitchenAI (Week 9). Without a key the AI features say "not set up";
# everything else runs. Use a key from a dedicated Anthropic Console workspace
# with its own spend limit (the hard cap). Never commit the real key.
ANTHROPIC_API_KEY=""
# The app's own monthly AI budget in USD (soft cap, below the Console limit). Default 20.
AI_MONTHLY_BUDGET_USD="20"
# Optional — the assistant's read-only database login (Week 9 Task 3). The
# migration creates the kitchen_ai_reader role without a password; set one on
# the server and put it here (docs/2026-11-19-week9-nl-query.md). Empty = the
# assistant answers cost questions only. Never commit the real password.
AI_DATABASE_URL=""

# Branch stock requests (Week 9 Task 10): requests for a day are due by this
# time (24-hour, Manila) the day before. Later ones are accepted, flagged Late.
STOCK_REQUEST_CUTOFF="15:00"

# Optional — email via Resend (Week 11). Without a key, emails are skipped
# (Admin → Email shows them as SKIPPED) and the in-app bell still works. Emails
# go only to users with a "notification email" set, never to the login email.
# Never commit the real key.
RESEND_API_KEY=
# Who emails come from. Until you verify a domain in Resend, keep the onboarding
# sender — it only delivers to your Resend account's own address.
EMAIL_FROM="KitchenERP <onboarding@resend.dev>"
